generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AssetType {
  stock
  hk
  crypto
}

enum ThemeMode {
  light
  dark
  system
}

enum ChangeColorScheme {
  cn
  us
}

enum LocaleCode {
  zh_CN
  zh_TW
  en
}

enum AlertCondition {
  gte
  lte
}

enum AlertStatus {
  active
  triggered
  disabled
}

enum OrderSide {
  buy
  sell
}

enum OrderType {
  market
  limit
  stop
}

enum OrderStatus {
  pending
  filled
  cancelled
  rejected
}

model User {
  id                String            @id @default(cuid())
  email             String            @unique
  passwordHash      String
  name              String?
  locale            LocaleCode        @default(zh_CN)
  theme             ThemeMode         @default(system)
  changeColorScheme ChangeColorScheme @default(cn)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  watchlist       WatchlistItem[]
  priceAlerts     PriceAlert[]
  comments        Comment[]
  alertDeliveries AlertDeliveryLog[]
  paperAccount    PaperAccount?
  paperPositions  PaperPosition[]
  paperOrders     PaperOrder[]
}

model WatchlistItem {
  id        String    @id @default(cuid())
  userId    String
  symbol    String
  assetType AssetType
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, symbol, assetType])
  @@index([userId])
}

model PriceAlert {
  id           String         @id @default(cuid())
  userId       String
  symbol       String
  assetType    AssetType
  condition    AlertCondition
  triggerPrice Decimal        @db.Decimal(18, 8)
  status       AlertStatus    @default(active)
  triggeredAt  DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries AlertDeliveryLog[]

  @@index([status])
  @@index([userId])
  @@index([symbol, assetType])
}

model Comment {
  id        String    @id @default(cuid())
  userId    String
  symbol    String
  assetType AssetType
  content   String
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([symbol, assetType, createdAt])
  @@index([userId])
}

model AlertDeliveryLog {
  id        String   @id @default(cuid())
  alertId   String
  userId    String
  email     String
  price     Decimal  @db.Decimal(18, 8)
  createdAt DateTime @default(now())

  alert PriceAlert @relation(fields: [alertId], references: [id], onDelete: Cascade)
  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([alertId])
}

model ApiCache {
  key       String   @id
  value     Json
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

model PaperAccount {
  id          String   @id @default(cuid())
  userId      String   @unique
  cashBalance Decimal  @db.Decimal(18, 4)
  currency    String   @default("USD")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PaperPosition {
  id        String    @id @default(cuid())
  userId    String
  symbol    String
  assetType AssetType
  qty       Decimal   @db.Decimal(18, 8)
  avgCost   Decimal   @db.Decimal(18, 8)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, symbol, assetType])
  @@index([userId])
}

model PaperOrder {
  id           String      @id @default(cuid())
  userId       String
  symbol       String
  assetType    AssetType
  side         OrderSide
  type         OrderType
  qty          Decimal     @db.Decimal(18, 8)
  limitPrice   Decimal?    @db.Decimal(18, 8)
  stopPrice    Decimal?    @db.Decimal(18, 8)
  status       OrderStatus @default(pending)
  filledPrice  Decimal?    @db.Decimal(18, 8)
  filledAt     DateTime?
  rejectReason String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([userId, status])
  @@index([symbol, assetType, status])
}
