generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AssetType {
  stock
  hk
  crypto
  cn
}

enum ThemeMode {
  light
  dark
  system
}

enum ChangeColorScheme {
  cn
  us
}

enum LocaleCode {
  zh_CN
  zh_TW
  en
}

enum AlertCondition {
  gte
  lte
}

enum AlertStatus {
  active
  triggered
  disabled
}

enum OrderSide {
  buy
  sell
}

enum OrderType {
  market
  limit
  stop
}

enum OrderStatus {
  pending
  filled
  cancelled
  rejected
}

enum EquityMarketVendor {
  longbridge
  futu
}

enum CryptoMarketVendor {
  binance
  okx
}

model User {
  id                String             @id @default(cuid())
  email             String             @unique
  /** Null for OAuth-only users (e.g. Google). */
  passwordHash      String?
  name              String?
  locale            LocaleCode         @default(zh_CN)
  theme             ThemeMode          @default(system)
  changeColorScheme ChangeColorScheme  @default(cn)
  /** Preferred broker for US/HK equity quotes & content. */
  equityVendor      EquityMarketVendor @default(longbridge)
  /** Preferred exchange for crypto quotes. */
  cryptoVendor      CryptoMarketVendor @default(binance)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  watchlist          WatchlistItem[]
  priceAlerts        PriceAlert[]
  comments           Comment[]
  alertDeliveries    AlertDeliveryLog[]
  paperAccount       PaperAccount?
  paperPositions     PaperPosition[]
  paperOrders        PaperOrder[]
  marketCredentials   UserMarketCredential[]
  serviceCredentials  UserServiceCredential[]
  passwordResetTokens PasswordResetToken[]
  inviteCodesOwned    InviteCode[]         @relation("InviteOwned")
  inviteCodeUsed      InviteCode?          @relation("InviteUsed")
}

/** One-time invite code owned by a user; optionally redeemed at registration. */
model InviteCode {
  id        String    @id @default(cuid())
  code      String    @unique
  ownerId   String
  usedById  String?   @unique
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  owner  User  @relation("InviteOwned", fields: [ownerId], references: [id], onDelete: Cascade)
  usedBy User? @relation("InviteUsed", fields: [usedById], references: [id], onDelete: SetNull)

  @@index([ownerId])
}

/** One-time password reset token (store SHA-256 hash only). */
model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

enum MarketCredentialProvider {
  longbridge
  futu
  binance
  okx
  fuyao
}

/** Encrypted per-user broker/exchange credentials (BYOK). */
model UserMarketCredential {
  id        String                   @id @default(cuid())
  userId    String
  provider  MarketCredentialProvider
  /** AES-256-GCM ciphertext (iv + tag + payload), base64. */
  payload   String
  updatedAt DateTime                 @updatedAt
  createdAt DateTime                 @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@index([userId])
}

enum ServiceCredentialProvider {
  email
  ai
}

/** Encrypted per-user email / AI credentials (BYOK). */
model UserServiceCredential {
  id        String                    @id @default(cuid())
  userId    String
  provider  ServiceCredentialProvider
  /** AES-256-GCM ciphertext (iv + tag + payload), base64. */
  payload   String
  updatedAt DateTime                  @updatedAt
  createdAt DateTime                  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@index([userId])
}

model WatchlistItem {
  id        String    @id @default(cuid())
  userId    String
  symbol    String
  assetType AssetType
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, symbol, assetType])
  @@index([userId])
}

model PriceAlert {
  id           String         @id @default(cuid())
  userId       String
  symbol       String
  assetType    AssetType
  condition    AlertCondition
  triggerPrice Decimal        @db.Decimal(18, 8)
  status       AlertStatus    @default(active)
  triggeredAt  DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries AlertDeliveryLog[]

  @@index([status])
  @@index([userId])
  @@index([symbol, assetType])
}

model Comment {
  id        String    @id @default(cuid())
  userId    String
  symbol    String
  assetType AssetType
  content   String
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([symbol, assetType, createdAt])
  @@index([userId])
}

model AlertDeliveryLog {
  id        String   @id @default(cuid())
  alertId   String
  userId    String
  email     String
  price     Decimal  @db.Decimal(18, 8)
  createdAt DateTime @default(now())

  alert PriceAlert @relation(fields: [alertId], references: [id], onDelete: Cascade)
  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([alertId])
}

model ApiCache {
  key       String   @id
  value     Json
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

model PaperAccount {
  id          String   @id @default(cuid())
  userId      String   @unique
  cashBalance Decimal  @db.Decimal(18, 4)
  currency    String   @default("USD")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PaperPosition {
  id        String    @id @default(cuid())
  userId    String
  symbol    String
  assetType AssetType
  qty       Decimal   @db.Decimal(18, 8)
  avgCost   Decimal   @db.Decimal(18, 8)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, symbol, assetType])
  @@index([userId])
}

model PaperOrder {
  id           String      @id @default(cuid())
  userId       String
  symbol       String
  assetType    AssetType
  side         OrderSide
  type         OrderType
  qty          Decimal     @db.Decimal(18, 8)
  limitPrice   Decimal?    @db.Decimal(18, 8)
  stopPrice    Decimal?    @db.Decimal(18, 8)
  status       OrderStatus @default(pending)
  filledPrice  Decimal?    @db.Decimal(18, 8)
  filledAt     DateTime?
  rejectReason String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([userId, status])
  @@index([symbol, assetType, status])
}
