generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AssetType {
  stock
  crypto
}

enum ThemeMode {
  light
  dark
  system
}

enum ChangeColorScheme {
  cn
  us
}

enum LocaleCode {
  zh_CN
  zh_TW
  en
}

enum AlertCondition {
  gte
  lte
}

enum AlertStatus {
  active
  triggered
  disabled
}

model User {
  id                String            @id @default(cuid())
  email             String            @unique
  passwordHash      String
  name              String?
  locale            LocaleCode        @default(zh_CN)
  theme             ThemeMode         @default(system)
  changeColorScheme ChangeColorScheme @default(cn)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  watchlist      WatchlistItem[]
  priceAlerts    PriceAlert[]
  comments       Comment[]
  alertDeliveries AlertDeliveryLog[]
}

model WatchlistItem {
  id        String    @id @default(cuid())
  userId    String
  symbol    String
  assetType AssetType
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, symbol, assetType])
  @@index([userId])
}

model PriceAlert {
  id           String         @id @default(cuid())
  userId       String
  symbol       String
  assetType    AssetType
  condition    AlertCondition
  triggerPrice Decimal        @db.Decimal(18, 8)
  status       AlertStatus    @default(active)
  triggeredAt  DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries AlertDeliveryLog[]

  @@index([status])
  @@index([userId])
  @@index([symbol, assetType])
}

model Comment {
  id        String    @id @default(cuid())
  userId    String
  symbol    String
  assetType AssetType
  content   String
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([symbol, assetType, createdAt])
  @@index([userId])
}

model AlertDeliveryLog {
  id        String   @id @default(cuid())
  alertId   String
  userId    String
  email     String
  price     Decimal  @db.Decimal(18, 8)
  createdAt DateTime @default(now())

  alert PriceAlert @relation(fields: [alertId], references: [id], onDelete: Cascade)
  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([alertId])
}

model ApiCache {
  key       String   @id
  value     Json
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}
