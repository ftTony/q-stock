<!DOCTYPE html><html class="dark" lang="en"><svg class="inline-defs-container" aria-hidden="true" style="position:absolute;width:0;height:0;overflow:hidden"></svg><head>
<meta charset="utf-8">
<meta content="width=device-width, initial-scale=1.0" name="viewport">
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&amp;display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet">
<style>
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }
        .glass-panel {
            background: rgba(5, 20, 36, 0.7);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.08);
        }
        .chart-gradient {
            background: linear-gradient(to bottom, rgba(173, 198, 255, 0.15), transparent);
        }
    </style>
<script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    "colors": {
                        "primary-fixed-dim": "#adc6ff",
                        "on-primary": "#002e6a",
                        "error-container": "#93000a",
                        "outline-variant": "#424754",
                        "surface-container-high": "#1c2b3c",
                        "tertiary-fixed": "#ffdcc6",
                        "primary-container": "#4d8eff",
                        "primary-fixed": "#d8e2ff",
                        "inverse-on-surface": "#233143",
                        "on-error": "#690005",
                        "on-primary-fixed": "#001a42",
                        "on-background": "#d4e4fa",
                        "surface-container": "#122131",
                        "secondary-fixed": "#d8e3fb",
                        "on-tertiary-fixed": "#311400",
                        "background": "#051424",
                        "on-surface": "#d4e4fa",
                        "surface-variant": "#273647",
                        "tertiary": "#ffb786",
                        "on-tertiary-container": "#461f00",
                        "secondary-container": "#3e495d",
                        "on-tertiary": "#502400",
                        "surface-dim": "#051424",
                        "on-secondary-fixed-variant": "#3c475a",
                        "surface-container-low": "#0d1c2d",
                        "on-primary-fixed-variant": "#004395",
                        "tertiary-container": "#df7412",
                        "secondary-fixed-dim": "#bcc7de",
                        "on-secondary-fixed": "#111c2d",
                        "on-primary-container": "#00285d",
                        "inverse-surface": "#d4e4fa",
                        "on-secondary": "#263143",
                        "tertiary-fixed-dim": "#ffb786",
                        "surface-container-lowest": "#010f1f",
                        "secondary": "#bcc7de",
                        "inverse-primary": "#005ac2",
                        "error": "#ffb4ab",
                        "surface-container-highest": "#273647",
                        "surface-tint": "#adc6ff",
                        "on-surface-variant": "#c2c6d6",
                        "on-tertiary-fixed-variant": "#723600",
                        "surface-bright": "#2c3a4c",
                        "surface": "#051424",
                        "outline": "#8c909f",
                        "primary": "#adc6ff",
                        "on-error-container": "#ffdad6"
                    },
                    "borderRadius": {
                        "DEFAULT": "0.125rem",
                        "lg": "0.25rem",
                        "xl": "0.5rem",
                        "full": "0.75rem"
                    },
                    "spacing": {
                        "xs": "4px",
                        "xl": "32px",
                        "md": "16px",
                        "margin": "24px",
                        "gutter": "16px",
                        "unit": "4px",
                        "sm": "8px",
                        "lg": "24px"
                    },
                    "fontFamily": {
                        "headline-md": ["Inter"],
                        "headline-sm": ["Inter"],
                        "body-md": ["Inter"],
                        "label-sm": ["Inter"],
                        "display-lg": ["Inter"],
                        "data-mono": ["Inter"],
                        "body-lg": ["Inter"]
                    },
                    "fontSize": {
                        "headline-md": ["24px", {"lineHeight": "1.3", "fontWeight": "600"}],
                        "headline-sm": ["18px", {"lineHeight": "1.4", "fontWeight": "600"}],
                        "body-md": ["14px", {"lineHeight": "1.5", "fontWeight": "400"}],
                        "label-sm": ["12px", {"lineHeight": "1", "letterSpacing": "0.05em", "fontWeight": "600"}],
                        "display-lg": ["48px", {"lineHeight": "1.2", "letterSpacing": "-0.02em", "fontWeight": "700"}],
                        "data-mono": ["14px", {"lineHeight": "1.4", "fontWeight": "500"}],
                        "body-lg": ["16px", {"lineHeight": "1.6", "fontWeight": "400"}]
                    }
                },
            },
        }
    </script>
<style>
    body {
      min-height: max(884px, 100dvh);
    }
  </style>
  </head>
<body class="bg-background text-on-surface font-body-md min-h-screen pb-32">
<!-- Top App Bar -->
<header class="sticky top-0 w-full z-50 bg-surface/80 backdrop-blur-md dark:bg-surface/80 border-b border-outline-variant/30 flex justify-between items-center px-md py-sm">
<div class="flex items-center gap-sm">
<button class="hover:bg-surface-variant/50 transition-all duration-200 p-xs rounded-full">
<span class="material-symbols-outlined text-primary">arrow_back</span>
</button>
<div class="flex flex-col">
<span class="font-headline-sm text-headline-sm text-primary">AAPL</span>
<span class="font-label-sm text-label-sm text-on-surface-variant">Apple Inc.</span>
</div>
</div>
<div class="flex items-center gap-md">
<span class="material-symbols-outlined text-primary hover:bg-surface-variant/50 p-xs rounded-full transition-all cursor-pointer">star</span>
<div class="w-8 h-8 rounded-full overflow-hidden border border-outline-variant">
<img alt="Profile" data-alt="A professional headshot of a financial analyst in a modern office setting. The lighting is sophisticated and directional, creating soft shadows. The overall aesthetic is clean and corporate, with a deep blue and slate grey color palette that conveys authority and precision." src="https://lh3.googleusercontent.com/aida-public/AB6AXuDAxZ0rL6w99tcCC7KVN_ImmervA0aA41WYya0UAkULtk5pKrps1H_OtpNID2MMmmmP2oZ3SKcHO1x93ylkjene07v5FoTzokdcobXHBYn68HsEpviSA_WNEShFof2w0SKHkYJLYRzKq6NPUQLQqB8EiNSs3GqnOfXshTmbSlwt2azVZikR7OoaYCUBmfuyTEQrcwgzIY0fjs-Q9D8FvrIU_6F0TpFJPjy8LofjPqiVadZHavhxJtorsDi5VmLB4xixbA0m25H2eKU">
</div>
</div>
</header>
<main class="px-margin pt-md space-y-lg">
<!-- Price Header Section -->
<section class="space-y-xs">
<div class="flex items-baseline gap-sm">
<h1 class="font-display-lg text-display-lg text-on-surface">$189.43</h1>
<span class="font-headline-sm text-headline-sm text-primary">+2.45 (1.31%)</span>
</div>
<div class="flex items-center gap-xs">
<span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
<span class="font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider">Market Open</span>
</div>
</section>
<!-- Chart Section -->
<section class="glass-panel rounded-xl p-md">
<div class="flex justify-between items-center mb-lg">
<div class="flex bg-surface-container rounded-lg p-xs">
<button class="px-md py-xs font-label-sm text-label-sm text-primary font-bold">1H</button>
<button class="px-md py-xs font-label-sm text-label-sm text-on-surface-variant hover:bg-surface-variant/50 rounded transition-all">1D</button>
<button class="px-md py-xs font-label-sm text-label-sm text-on-surface-variant hover:bg-surface-variant/50 rounded transition-all">1W</button>
<button class="px-md py-xs font-label-sm text-label-sm text-on-surface-variant hover:bg-surface-variant/50 rounded transition-all">1M</button>
<button class="px-md py-xs font-label-sm text-label-sm text-on-surface-variant hover:bg-surface-variant/50 rounded transition-all">1Y</button>
</div>
<button class="p-xs text-on-surface-variant hover:text-primary transition-colors">
<span class="material-symbols-outlined">candlestick_chart</span>
</button>
</div>
<!-- Mock Chart Area -->
<div class="relative h-64 w-full">
<svg class="w-full h-full" preserveAspectRatio="none" viewBox="0 0 400 200">
<defs>
<linearGradient id="chartFill" x1="0" x2="0" y1="0" y2="1">
<stop offset="0%" stop-color="#3B82F6" stop-opacity="0.2"></stop>
<stop offset="100%" stop-color="#3B82F6" stop-opacity="0"></stop>
</linearGradient>
</defs>
<path d="M0 150 Q 50 120, 100 130 T 200 80 T 300 100 T 400 40 L 400 200 L 0 200 Z" fill="url(#chartFill)"></path>
<path d="M0 150 Q 50 120, 100 130 T 200 80 T 300 100 T 400 40" fill="none" stroke="#3B82F6" stroke-width="2.5"></path>
<!-- Grid Lines -->
<line stroke="white" stroke-opacity="0.05" x1="0" x2="400" y1="40" y2="40"></line>
<line stroke="white" stroke-opacity="0.05" x1="0" x2="400" y1="80" y2="80"></line>
<line stroke="white" stroke-opacity="0.05" x1="0" x2="400" y1="120" y2="120"></line>
<line stroke="white" stroke-opacity="0.05" x1="0" x2="400" y1="160" y2="160"></line>
</svg>
<!-- Price Indicator -->
<div class="absolute top-10 right-0 transform translate-x-1/2 flex flex-col items-center">
<div class="w-3 h-3 bg-primary rounded-full border-2 border-background"></div>
<div class="bg-primary px-sm py-xs rounded mt-xs shadow-lg">
<span class="font-data-mono text-label-sm text-on-primary">$189.43</span>
</div>
</div>
</div>
</section>
<!-- Key Statistics Bento Grid -->
<section class="grid grid-cols-2 gap-md">
<div class="glass-panel p-md rounded-xl space-y-xs">
<span class="font-label-sm text-label-sm text-on-surface-variant">Market Cap</span>
<p class="font-headline-sm text-headline-sm text-on-surface">2.98T</p>
</div>
<div class="glass-panel p-md rounded-xl space-y-xs">
<span class="font-label-sm text-label-sm text-on-surface-variant">P/E Ratio</span>
<p class="font-headline-sm text-headline-sm text-on-surface">31.42</p>
</div>
<div class="glass-panel p-md rounded-xl space-y-xs">
<span class="font-label-sm text-label-sm text-on-surface-variant">Avg Volume</span>
<p class="font-headline-sm text-headline-sm text-on-surface">54.2M</p>
</div>
<div class="glass-panel p-md rounded-xl space-y-xs">
<span class="font-label-sm text-label-sm text-on-surface-variant">Dividend Yield</span>
<p class="font-headline-sm text-headline-sm text-on-surface">0.51%</p>
</div>
</section>
<!-- Order Book Snippet -->
<section class="glass-panel rounded-xl overflow-hidden">
<div class="px-md py-sm border-b border-outline-variant/30 flex justify-between items-center">
<h3 class="font-headline-sm text-headline-sm text-on-surface">Order Book</h3>
<span class="font-label-sm text-label-sm text-primary">Live</span>
</div>
<div class="p-md space-y-sm">
<div class="grid grid-cols-3 gap-xs font-label-sm text-label-sm text-on-surface-variant">
<span>Bid Size</span>
<span class="text-center">Price</span>
<span class="text-right">Ask Size</span>
</div>
<!-- Rows -->
<div class="grid grid-cols-3 gap-xs font-data-mono text-body-md py-xs border-b border-white/5">
<span class="text-emerald-500">1,200</span>
<span class="text-center">189.42</span>
<span class="text-right text-error">450</span>
</div>
<div class="grid grid-cols-3 gap-xs font-data-mono text-body-md py-xs border-b border-white/5">
<span class="text-emerald-500">800</span>
<span class="text-center">189.41</span>
<span class="text-right text-error">920</span>
</div>
<div class="grid grid-cols-3 gap-xs font-data-mono text-body-md py-xs">
<span class="text-emerald-500">2,150</span>
<span class="text-center">189.40</span>
<span class="text-right text-error">1,100</span>
</div>
</div>
</section>
</main>
<!-- Fixed Trade Button -->
<div class="fixed bottom-[72px] left-0 w-full px-margin z-40">
<button class="w-full bg-primary text-on-primary py-md rounded-full font-headline-sm text-headline-sm shadow-2xl active:opacity-80 active:scale-95 transition-all flex items-center justify-center gap-sm">
            Trade AAPL
            <span class="material-symbols-outlined">swap_horiz</span>
</button>
</div>
<!-- Bottom Navigation Bar -->
<nav class="fixed bottom-0 left-0 w-full z-50 flex justify-around items-center px-4 py-2 bg-surface/90 backdrop-blur-xl dark:bg-surface-container/90 border-t border-outline-variant/20 rounded-t-xl">
<div class="flex flex-col items-center justify-center text-primary dark:text-primary-fixed-dim font-bold">
<span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">show_chart</span>
<span class="font-label-sm text-label-sm">Market</span>
</div>
<div class="flex flex-col items-center justify-center text-on-surface-variant dark:text-on-surface-variant hover:bg-primary-container/10 transition-colors">
<span class="material-symbols-outlined">star</span>
<span class="font-label-sm text-label-sm">Watchlist</span>
</div>
<div class="flex flex-col items-center justify-center text-on-surface-variant dark:text-on-surface-variant hover:bg-primary-container/10 transition-colors">
<span class="material-symbols-outlined">account_balance_wallet</span>
<span class="font-label-sm text-label-sm">Portfolio</span>
</div>
<div class="flex flex-col items-center justify-center text-on-surface-variant dark:text-on-surface-variant hover:bg-primary-container/10 transition-colors">
<span class="material-symbols-outlined">person</span>
<span class="font-label-sm text-label-sm">Profile</span>
</div>
</nav>
</body></html>