<!-- Main Content Area -->
<main class="flex-1 md:ml-64 p-lg overflow-y-auto custom-scrollbar">
<!-- Header Actions -->
<div class="flex flex-col md:flex-row md:items-center justify-between gap-md mb-lg">
<div>
<h1 class="text-headline-md font-headline-md text-on-surface">Tech Giants Watchlist</h1>
<p class="text-body-md font-body-md text-on-surface-variant">Real-time monitoring of high-cap technology stocks</p>
</div>
<div class="flex items-center gap-sm">
<div class="relative group">
<span class="material-symbols-outlined absolute left-sm top-1/2 -translate-y-1/2 text-outline text-[20px]">search</span>
<input class="bg-surface-container-high border border-outline-variant/30 rounded-lg pl-lg pr-md py-sm text-body-md text-on-surface focus:outline-none focus:border-primary transition-all w-64" placeholder="Add ticker (e.g. NVDA)..." type="text">
</div>
<button class="flex items-center gap-xs px-md py-sm bg-surface-container-high text-on-surface border border-outline-variant/30 rounded-lg hover:bg-surface-container-highest transition-colors font-medium">
<span class="material-symbols-outlined">filter_list</span> Filter
                    </button>
<button class="flex items-center gap-xs px-md py-sm bg-primary text-on-primary rounded-lg hover:brightness-110 transition-all font-bold">
<span class="material-symbols-outlined">add</span> Create
                    </button>
</div>
</div>
<!-- Dashboard Summary Tiles (Bento Style) -->
<div class="grid grid-cols-1 md:grid-cols-4 gap-md mb-lg">
<div class="glass-panel p-md rounded-xl">
<span class="text-label-sm font-label-sm text-on-surface-variant block mb-xs">Active Tickers</span>
<div class="flex items-end gap-sm">
<span class="text-headline-md font-headline-md">12</span>
<span class="text-tertiary font-bold text-label-sm pb-xs">+3 Today</span>
</div>
</div>
<div class="glass-panel p-md rounded-xl">
<span class="text-label-sm font-label-sm text-on-surface-variant block mb-xs">Avg. Daily Change</span>
<div class="flex items-end gap-sm text-emerald-400">
<span class="text-headline-md font-headline-md">+1.42%</span>
<span class="material-symbols-outlined pb-xs">trending_up</span>
</div>
</div>
<div class="glass-panel p-md rounded-xl">
<span class="text-label-sm font-label-sm text-on-surface-variant block mb-xs">Top Performer</span>
<div class="flex items-end gap-sm">
<span class="text-headline-md font-headline-md text-primary">AAPL</span>
<span class="text-emerald-400 font-bold text-label-sm pb-xs">+2.8%</span>
</div>
</div>
<div class="glass-panel p-md rounded-xl border-error/20">
<span class="text-label-sm font-label-sm text-on-surface-variant block mb-xs">Alert Status</span>
<div class="flex items-center gap-sm">
<span class="w-2 h-2 rounded-full bg-error animate-pulse"></span>
<span class="text-label-sm font-label-sm text-on-surface">3 Volatility Alerts</span>
</div>
</div>
</div>
<!-- Watchlist Table -->
<div class="glass-panel rounded-xl overflow-hidden">
<div class="overflow-x-auto">
