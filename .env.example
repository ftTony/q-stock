# App
APP_URL=http://localhost:3000
AUTH_SECRET=replace-with-a-long-random-secret
AUTH_TRUST_HOST=true

# Database
DATABASE_URL=postgresql://qstock:qstock@localhost:5432/qstock?schema=public

# Market data provider priority (CSV). Omit to auto-detect from configured credentials.
# Equity default: longbridge → futu → finnhub
# Content (news/press/company/earnings/IPO) uses the same order.
# To disable Longbridge and fall back to Futu: MARKET_DATA_PROVIDERS=futu,finnhub,binance
# Crypto default (no env override): binance → finnhub → longbridge
MARKET_DATA_PROVIDERS=longbridge,futu,finnhub,binance

# Optional Binance public API base (crypto klines/quotes; no key required)
# BINANCE_API_URL=https://data-api.binance.vision

# Longbridge OpenAPI (cloud)
LONGBRIDGE_APP_KEY=
LONGBRIDGE_APP_SECRET=
LONGBRIDGE_ACCESS_TOKEN=
# LONGBRIDGE_ENABLE_OVERNIGHT=false

# Futu OpenAPI cloud REST — https://open.futunn.com/api/overview/getting-started
# Method 2 (server/backend, recommended here): AppKey + private key signature.
# Private key: PEM, or base64/hex PKCS#8 DER (console one-liner OK).
FUTU_APP_KEY=
FUTU_PRIVATE_KEY=
# FUTU_PRIVATE_KEY_PATH=./secrets/futu-private.pem
FUTU_SIGN_ALG=ed25519
# Method 1 (OAuth Bearer) — used only when AppKey auth is not configured:
# FUTU_ACCESS_TOKEN=
# FUTU_HTTP_URL=https://webapi.futunn.com

# Finnhub (fallback quotes + news / earnings / press)
FINNHUB_API_KEY=

# Sentiment
ADANOS_API_KEY=

# AI trend analysis (Vercel AI SDK + DeepSeek)
DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-v4-flash
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# Email (prefer Resend; SMTP is fallback)
EMAIL_FROM=alerts@example.com
RESEND_API_KEY=
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=false

# Price alert / paper-order worker
ALERT_POLL_INTERVAL_MS=45000
