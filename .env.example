# App
APP_URL=http://localhost:3000
AUTH_SECRET=replace-with-openssl-rand-hex-32-or-longer
AUTH_TRUST_HOST=true
# Keep AUTH_URL and APP_URL on the same public origin in production.
AUTH_URL=http://localhost:3000
# Google OAuth (optional). Callback: {APP_URL}/api/auth/callback/google
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
# If the server cannot reach accounts.google.com (common in CN), point Node at
# the same local proxy your browser uses, e.g. Clash: http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:17890
# HTTP_PROXY=http://127.0.0.1:17890
# NO_PROXY=localhost,127.0.0.1
# GitHub OAuth (optional). Callback: {APP_URL}/api/auth/callback/github
# AUTH_GITHUB_ID=
# AUTH_GITHUB_SECRET=

# Database
DATABASE_URL=postgresql://qstock:qstock@localhost:5432/qstock?schema=public

# Encrypts per-user Longbridge/Futu keys (BYOK). Required for Settings → market credentials.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CREDENTIALS_ENCRYPTION_KEY=

# Market data provider priority (CSV). Omit to auto-detect from configured credentials.
# US/HK equity: longbridge → futu → finnhub
# A-shares (assetType=cn): longbridge / futu (Fuyao optional)
# Creds resolution: platform env keys first; if unset, use user BYOK from Settings.
# Guests / users without BYOK: platform env (if set) → Finnhub + Binance public
# Crypto default (no env override): binance → finnhub
MARKET_DATA_PROVIDERS=longbridge,futu,finnhub,binance

# Tonghuashun Fuyao (optional platform key). Falls back to user BYOK when unset.
# Docs: https://fuyao.aicubes.cn/docs/api-reference/overview/
# FUYAO_API_KEY=
# FUYAO_API_BASE=https://fuyao.aicubes.cn

# Optional crypto hosts. Users pick Binance/OKX in Settings; API keys optional.
# BINANCE_API_URL=https://data-api.binance.vision
# BINANCE_WEB_URL=https://www.binance.com
# BINANCE_API_KEY=
# BINANCE_API_SECRET=
# OKX_API_URL=https://www.okx.com
# OKX_API_KEY=
# OKX_API_SECRET=
# OKX_PASSPHRASE=

# Platform market keys (optional). When set, used for all users before BYOK.
# LONGBRIDGE_APP_KEY=
# LONGBRIDGE_APP_SECRET=
# LONGBRIDGE_ACCESS_TOKEN=
# FUTU_APP_KEY=
# FUTU_PRIVATE_KEY=
# FUTU_SIGN_ALG=ed25519
# FUTU_ACCESS_TOKEN=
# FUTU_HTTP_URL=https://webapi.futunn.com
# Finnhub (platform fallback quotes + news / earnings / press)
FINNHUB_API_KEY=

# Sentiment
ADANOS_API_KEY=

# AI trend analysis — platform fallback when user has no Settings BYOK
# (Users can also set DeepSeek / OpenAI / Gemini / Anthropic in Settings.)
DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-v4-flash
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# Email — platform default for welcome / password-reset, and alert fallback
# when the user has not configured Resend/SMTP in Settings.
EMAIL_FROM=alerts@example.com
RESEND_API_KEY=
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=false

# Price alert / paper-order worker
ALERT_POLL_INTERVAL_MS=45000
