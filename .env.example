# App
APP_URL=http://localhost:3000
AUTH_SECRET=replace-with-a-long-random-secret
AUTH_TRUST_HOST=true

# Database
DATABASE_URL=postgresql://qstock:qstock@localhost:5432/qstock?schema=public

# Encrypts per-user Longbridge/Futu keys (BYOK). Required for Settings → market credentials.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CREDENTIALS_ENCRYPTION_KEY=

# Market data provider priority (CSV). Omit to auto-detect from configured credentials.
# Equity: longbridge → futu → finnhub (LB/Futu only when the logged-in user saved BYOK keys)
# Guests / users without BYOK: Finnhub + Binance only
# Content (news/press/company/earnings/IPO) uses the same order when BYOK is present.
# Crypto default (no env override): binance → finnhub → longbridge
MARKET_DATA_PROVIDERS=longbridge,futu,finnhub,binance

# Optional Binance public API base (crypto klines/quotes; no key required)
# BINANCE_API_URL=https://data-api.binance.vision

# --- Deprecated for Web serving ---
# Longbridge / Futu env keys are NOT used for /api/* market responses.
# Users paste their own keys in Settings (encrypted in DB).
# Keep these only for optional local scripts outside the web app:
# LONGBRIDGE_APP_KEY=
# LONGBRIDGE_APP_SECRET=
# LONGBRIDGE_ACCESS_TOKEN=
# FUTU_APP_KEY=
# FUTU_PRIVATE_KEY=
# FUTU_SIGN_ALG=ed25519
# FUTU_ACCESS_TOKEN=
# FUTU_HTTP_URL=https://webapi.futunn.com

# Finnhub (platform fallback quotes + news / earnings / press)
FINNHUB_API_KEY=

# Sentiment
ADANOS_API_KEY=

# AI trend analysis (Vercel AI SDK + DeepSeek)
DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-v4-flash
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# Email (prefer Resend; SMTP is fallback)
EMAIL_FROM=alerts@example.com
RESEND_API_KEY=
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=false

# Price alert / paper-order worker
ALERT_POLL_INTERVAL_MS=45000
